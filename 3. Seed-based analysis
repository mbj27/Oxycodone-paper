clc;
clear all;

%% Load the mean matrices
load('mean_matrices_oxy2.mat');      % size: nodes x nodes x subjects
load('mean_matrices_placebo2.mat');  % size: nodes x nodes x subjects

%% Define node-to-node groups
% Each row: [node_i, node_j, group_id]
specific_cells = [
    83, 219, 1; % First group: R dACC (83 and 84) and L dACC (219, 220 and 221) (2x3)
    83, 220, 1; 
    83, 221, 1;
    84, 219, 1; 
    84, 220, 1; 
    84, 221, 1;
    83, 34, 2; % Second group: R dACC and R insula (2x4)
    83, 35, 2; 
    83, 36, 2; 
    83, 37, 2;
    84, 34, 2; 
    84, 35, 2; 
    84, 36, 2; 
    84, 37, 2;
    83, 168, 3; % Third group: R dACC and L insula (2x3)
    83, 169, 3; 
    83, 170, 3;
    84, 168, 3; 
    84, 169, 3; 
    84, 170, 3;
    83, 124, 4; % Fourth group: R dACC and R putamen (2x2)
    83, 125, 4; 
    84, 124, 4; 
    84, 125, 4;
    83, 261, 5; % Fifth group: R dACC and L putamen (2x1)
    84, 261, 5;
    219, 34, 6; % Sixth group: L dACC and R insula (3x4)
    219, 35, 6; 
    219, 36, 6; 
    219, 37, 6;
    220, 34, 6; 
    220, 35, 6; 
    220, 36, 6; 
    220, 37, 6;
    221, 34, 6; 
    221, 35, 6; 
    221, 36, 6; 
    221, 37, 6;
    219, 168, 7; % Seventh group: L dACC and L insula (3x3)
    219, 169, 7; 
    219, 170, 7;
    220, 168, 7; 
    220, 169, 7; 
    220, 170, 7;
    221, 168, 7; 
    221, 169, 7; 
    221, 170, 7;
    219, 124, 8; % Eigth group: L dACC and R putamen (3x2)
    219, 125, 8; 
    220, 124, 8; 
    220, 125, 8;
    221, 124, 8; 
    221, 125, 8;
    219, 261, 9; % Ninth group: L dACC and L putamen (3x1)
    220, 261, 9; 
    221, 261, 9;
];

num_groups = max(specific_cells(:,3)); % num_groups = 9 

%% Initialize containers
grouped_connectivity_oxy     = cell(num_groups,1);
grouped_connectivity_placebo = cell(num_groups,1);

%% Extract node-to-node connectivity for each subject
for k = 1:size(specific_cells,1)
    i     = specific_cells(k,1);
    j     = specific_cells(k,2);
    group = specific_cells(k,3);
    
    x_oxy      = squeeze(mean_matrices_oxy(i,j,:));
    y_placebo  = squeeze(mean_matrices_placebo(i,j,:));
    
    % Concatenate edges within the same node-to-node group
    grouped_connectivity_oxy{group}     = [grouped_connectivity_oxy{group}, x_oxy];
    grouped_connectivity_placebo{group} = [grouped_connectivity_placebo{group}, y_placebo];
end

%% Paired t-test across subjects (average edges per node-to-node connection)
p_uncorrected = zeros(num_groups,1);
t_stats      = zeros(num_groups,1);
stats_ttest  = cell(num_groups,1);

for g = 1:num_groups
    x = grouped_connectivity_oxy{g};      % subjects x edges
    y = grouped_connectivity_placebo{g};  % subjects x edges
    
    % Average across edges per subject
    x_avg = mean(x,2);
    y_avg = mean(y,2);
    
    % Paired t-test
    [~, p, ~, stats] = ttest(x_avg, y_avg);
    
    p_uncorrected(g) = p;
    t_stats(g)      = stats.tstat;
    stats_ttest{g}  = stats;
end

%% Bonferroni correction
p_bonferroni = min(p_uncorrected * num_groups, 1);
alpha = 0.05;

%% Display results
group_titles = {'L ACC - R ACC','R ACC - R insula','R ACC - L insula','R ACC - R putamen','R ACC - L putamen',...
                'L ACC - R insula','L ACC - L insula','L ACC - R putamen','L ACC - L putamen'};

fprintf('Node-to-Node Connectivity Paired t-test Results:\n');
fprintf('Group Title                | t-statistic | p_uncorr | p_bonf | Significant\n');
fprintf('--------------------------------------------------------------------------\n');

for g = 1:num_groups
    signif = 'No';
    if p_bonferroni(g) < alpha
        signif = 'Yes';
    end
    fprintf('%-25s | %-11.3f | %-9.4f | %-7.4f | %s\n', ...
        group_titles{g}, t_stats(g), p_uncorrected(g), p_bonferroni(g), signif);
end

figure;
t = tiledlayout(2, 4, ...
    'TileSpacing', 'compact', ...
    'Padding', 'compact');

for g = 2:num_groups
    nexttile

    x = grouped_connectivity_oxy{g};
    y = grouped_connectivity_placebo{g};

    x_avg = mean(x,2);
    y_avg = mean(y,2);

    boxplot([y_avg, x_avg], ...
        'Labels', {'Placebo','Oxy'}, ...
        'Widths', 0.5);

    title(group_titles{g}, 'FontSize', 11)
    ylabel('Mean Connectivity (r)')

    p = p_bonferroni(g);

    if p < 0.001
        sig = '***';
    elseif p < 0.01
        sig = '**';
    elseif p < 0.05
        sig = '*';
    else
        sig = 'n.s.';
    end

    y_max = max([x_avg; y_avg]);
    y_min = min([x_avg; y_avg]);
    y_range = y_max - y_min;

    y_line = y_max + 0.15*y_range;
    y_text = y_line + 0.05*y_range;

    ylim([y_min, y_max + 0.3*y_range])

    hold on
    plot([1 2], [y_line y_line], 'k', 'LineWidth', 1.5)
    text(1.5, y_line + 0.05*y_range, sig, ...
        'HorizontalAlignment','center', ...
        'FontSize', 11)
    hold off
end

title(t, 'Circuit-wise Connectivity (Bonferroni corrected)', ...
    'FontWeight','bold');
